{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x64",
      "inherits": "base",
      "displayName": "x64 (run from an x64 VS dev shell: tools/dev.ps1 -Arch x64)",
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "x86",
      "inherits": "base",
      "displayName": "x86 (run from an x86 VS dev shell: tools/dev.ps1 -Arch x86)",
      "architecture": { "value": "x86", "strategy": "external" }
    },
    {
      "name": "arm64",
      "inherits": "base",
      "displayName": "arm64 (not built or tested; for forks. Needs the ARM64 MSVC tools: tools/dev.ps1 -Arch arm64)",
      "architecture": { "value": "arm64", "strategy": "external" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release" },
    { "name": "x86-debug", "configurePreset": "x86", "configuration": "Debug" },
    { "name": "x86-release", "configurePreset": "x86", "configuration": "Release" },
    { "name": "arm64-debug", "configurePreset": "arm64", "configuration": "Debug" },
    { "name": "arm64-release", "configurePreset": "arm64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "x86-debug", "configurePreset": "x86", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
